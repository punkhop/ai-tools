<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.qmd-upgrade</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/.claude/bin/qmd-upkeep</string>
