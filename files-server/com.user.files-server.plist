<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Always-on files-server (Mac). Install: see START-HERE.md, stage 4. -->
  <key>Label</key>
  <string>com.user.files-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/.claude/bin/files-server</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/files-server.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/files-server.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>MEMORY_ROOT</key>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/memory</string>
  </dict>
</dict>
</plist>
