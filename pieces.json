      "files": [
        {"from": "bibles/01-DEVELOPMENT-BIBLE.md", "to": "ai-tools/bibles/01-DEVELOPMENT-BIBLE.md"},
        {"from": "hooks/ai-tools-check.sh", "to": "hooks/ai-tools-check.sh", "exec": true}
      ],
      "settings": "dev-bible",
      "claude_md": "claude-md/dev-bible.md",
      "try": "Ask Claude to build you something small. It plans, tests and explains in plain words without being told."
    },
    "reply-format": {
