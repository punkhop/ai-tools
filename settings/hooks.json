{
  "_comment": "Grouped per piece. tools/aitools.py merges 'base' always, then only the groups for the pieces the user chose, into ~/.claude/settings.json (lists are appended without duplicates; a single setting like statusLine is set only when they have none; existing settings are kept). Uninstall removes only what the merge added.",
  "base": {
    "permissions": {
      "allow": [
        "Read",
        "Glob",
        "Grep",
        "Skill",
        "WebFetch",
        "WebSearch",
        "Bash(ls:*)",
        "Bash(pwd)",
        "Bash(cat:*)",
        "Bash(grep:*)",
        "Bash(find:*)",
        "Bash(git status:*)",
        "Bash(git log:*)",
        "Bash(git diff:*)",
        "Bash(git branch:*)",
        "Bash(launchctl list:*)",
        "Bash(systemctl --user list-timers:*)",
        "Bash(systemctl --user status:*)",
        "Bash(systemctl --user is-active:*)",
        "Bash(claude mcp list)",
        "Bash(tail:*)",
        "Bash(stat:*)",
        "Bash(date)"
      ],
      "deny": [
        "Bash(sudo:*)",
        "Bash(rm -rf /)",
        "Bash(rm -rf ~)",
        "Bash(rm -rf $HOME)",
        "Bash(git push --force:*)",
        "Bash(git reset --hard:*)"
      ]
    }
  },
  "dev-bible": {
    "hooks": {
      "SessionStart": [
        {
          "matcher": "startup",
          "hooks": [
            {
              "type": "command",
              "command": "~/.claude/hooks/ai-tools-check.sh"
            }
          ]
        }
      ]
    }
  },
  "safety-hooks": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|Read",
          "hooks": [
            {
              "type": "command",
              "command": "python3 ~/.claude/hooks/block-secrets.py"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "~/.claude/hooks/block-rm-untracked.sh"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "~/.claude/hooks/context-budget-feedback.sh"
            }
          ]
        }
      ]
    }
  },
  "session-save": {
    "hooks": {
      "SessionEnd": [
        {
          "matcher": ".*",
          "hooks": [
            {
              "type": "command",
              "command": "~/.claude/hooks/session-save.sh"
            }
          ]
        }
      ]
    }
  },
  "qmd": {
    "permissions": {
      "allow": [
        "Bash(qmd:*)",
        "mcp__qmd__query",
        "mcp__qmd__get",
        "mcp__qmd__multi_get",
        "mcp__qmd__status"
      ]
    }
  },
  "files-server": {
    "permissions": {
      "allow": [
        "Bash(~/.claude/bin/files-server url:*)"
      ]
    }
  },
  "tailscale": {
    "permissions": {
      "allow": [
        "Bash(tailscale status:*)"
      ]
    }
  },
  "review-multi": {
    "permissions": {
      "allow": [
        "Bash(codex --version)",
        "Bash(codex login status)"
      ]
    }
  },
  "permissions": {
    "permissions": {
      "allow": [
        "Edit",
        "Write",
        "NotebookEdit",
        "Agent",
        "Task",
        "TodoWrite",
        "ToolSearch",
        "AskUserQuestion",
        "Bash(git add:*)",
        "Bash(git commit:*)",
        "Bash(git checkout:*)",
        "Bash(git switch:*)",
        "Bash(git fetch:*)",
        "Bash(git pull:*)",
        "Bash(git push:*)",
        "Bash(git show:*)",
        "Bash(git stash:*)",
        "Bash(git merge:*)",
        "Bash(git remote:*)",
        "Bash(git rev-parse:*)",
        "Bash(git tag:*)",
        "Bash(git worktree:*)",
        "Bash(git init:*)",
        "Bash(git clone:*)",
        "Bash(gh repo view:*)",
        "Bash(gh pr view:*)",
        "Bash(gh pr list:*)",
        "Bash(gh run list:*)",
        "Bash(gh run view:*)",
        "Bash(npm install:*)",
        "Bash(npm i:*)",
        "Bash(npm ci:*)",
        "Bash(npm run:*)",
        "Bash(npm test:*)",
        "Bash(npm view:*)",
        "Bash(npm ls:*)",
        "Bash(npm outdated:*)",
        "Bash(npx:*)",
        "Bash(node:*)",
        "Bash(bun:*)",
        "Bash(bunx:*)",
        "Bash(pnpm:*)",
        "Bash(yarn:*)",
        "Bash(python3:*)",
        "Bash(python:*)",
        "Bash(pip install:*)",
        "Bash(uv:*)",
        "Bash(head:*)",
        "Bash(wc:*)",
        "Bash(sort:*)",
        "Bash(uniq:*)",
        "Bash(diff:*)",
        "Bash(cut:*)",
        "Bash(tr:*)",
        "Bash(which:*)",
        "Bash(echo:*)",
        "Bash(file:*)",
        "Bash(du:*)",
        "Bash(df:*)",
        "Bash(ps:*)",
        "Bash(lsof:*)",
        "Bash(tree:*)",
        "Bash(jq:*)",
        "Bash(sed -n:*)",
        "Bash(realpath:*)",
        "Bash(basename:*)",
        "Bash(dirname:*)",
        "Bash(mkdir:*)",
        "Bash(touch:*)",
        "Bash(cp:*)",
        "Bash(chmod +x:*)",
        "Bash(cd:*)",
        "Bash(sleep:*)",
        "Bash(open:*)",
        "Bash(xdg-open:*)",
        "Bash(uname:*)",
        "Bash(whoami)",
        "Bash(id)",
        "Bash(curl -s http://localhost:*)",
        "Bash(curl -sI http://localhost:*)",
        "Bash(curl -s http://127.0.0.1:*)"
      ],
      "deny": [
        "Bash(git push -f:*)",
        "Bash(git push --force-with-lease:*)",
        "Bash(git clean:*)",
        "Bash(npm publish:*)",
        "Bash(chmod -R 777:*)",
        "Bash(mkfs:*)",
        "Bash(dd:*)"
      ],
      "ask": [
        "Bash(git push origin main:*)",
        "Bash(git push origin master:*)",
        "Bash(git checkout --:*)",
        "Bash(git checkout .:*)",
        "Bash(git stash drop:*)",
        "Bash(git stash clear:*)",
        "Bash(git tag -d:*)",
        "Bash(git remote remove:*)",
        "Bash(git remote set-url:*)",
        "Bash(git worktree remove:*)",
        "Bash(npm uninstall:*)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "python3 ~/.claude/hooks/block-broad-kill.py"
            }
          ]
        }
      ]
    }
  },
  "resume": {
    "hooks": {
      "SessionStart": [
        {
          "matcher": "startup|clear",
          "hooks": [
            {
              "type": "command",
              "command": "python3 ~/.claude/hooks/recent-sessions.py",
              "timeout": 5
            }
          ]
        }
      ]
    }
  },
  "browser": {
    "permissions": {
      "allow": [
        "mcp__chrome-devtools__*"
      ]
    }
  },
  "status-bar": {
    "statusLine": {
      "type": "command",
      "command": "~/.claude/statusline.sh",
      "padding": 0
    }
  }
}
